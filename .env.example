# LLM / VLM Provider: "gemini" or "mock"
VLM_PROVIDER=gemini

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI configuration (if using OpenAI GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Audit Tolerance settings
DISCREPANCY_TOLERANCE_CENTS=0.02
